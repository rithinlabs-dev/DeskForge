{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Trusted first-party main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-get-snapshot",
    "allow-set-polling-visible",
    "allow-set-poll-interval",
    "allow-set-wallpaper",
    "allow-launcher-list",
    "allow-launcher-register",
    "allow-launcher-remove",
    "allow-launcher-launch",
    "allow-settings-get",
    "allow-settings-set",
    "allow-themes-list",
    "allow-theme-save",
    "allow-theme-delete",
    "allow-theme-export-file",
    "allow-theme-import-file",
    "allow-widget-store-load",
    "allow-widget-store-save",
    "allow-desktop-list",
    "allow-desktop-pin",
    "allow-desktop-unpin",
    "allow-menu-open",
    "allow-media-list",
    "allow-media-import-video",
    "allow-media-remove",
    "allow-wallpaper-start",
    "allow-wallpaper-stop",
    "allow-wallpaper-status",
    "allow-blender-detect",
    "allow-blender-set-path",
    "allow-blender-render-start",
    "allow-blender-cancel",
    "allow-fx-start",
    "allow-fx-stop",
    "allow-fx-status",
    "allow-desktop-set-glass",
    "allow-desktop-glass-status",
    "allow-desktop-glass-diagnostics",
    "allow-compose-restore-wallpaper",
    "allow-image-save-png",
    "allow-island-start",
    "allow-island-stop",
    "allow-island-status",
    "allow-island-monitors",
    "allow-nowplaying-state",
    "allow-image-list",
    "allow-image-import",
    "allow-image-remove",
    "allow-image-data",
    "allow-compose-set-wallpaper"
  ]
}
